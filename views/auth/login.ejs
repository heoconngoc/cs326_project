<%- include('../partials/header') %>
<%
  const input = 'block w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-base shadow-sm placeholder:text-stone-500 focus:border-red-800 focus:outline-none focus:ring-2 focus:ring-red-800/30';
  const label = 'mb-1 block text-sm font-medium text-stone-800';
%>

<div class="mx-auto max-w-md">
  <h1 class="mb-2 text-2xl font-bold tracking-tight">Log in</h1>
  <p class="mb-6 text-stone-600">
    New here? <a class="font-medium text-red-900 underline" href="/signup">Create an account</a>.
  </p>

  <%# hx-post sends the form to POST /auth/login. On success the server answers
      with an HX-Redirect header and htmx sends the browser to the list. %>
  <form id="login-form" action="/auth/login" method="post"
        class="group rounded-xl border border-stone-200 bg-white p-4 shadow-sm sm:p-6"
        hx-post="/auth/login"
        hx-target="#form-feedback"
        hx-swap="innerHTML show:#form-feedback:top"
        hx-sync="this:drop"
        hx-on::send-error="document.getElementById('form-feedback').innerHTML = document.getElementById('tpl-network-error').innerHTML"
        hx-on::timeout="document.getElementById('form-feedback').innerHTML = document.getElementById('tpl-timeout').innerHTML">
    <p class="mb-4 text-sm text-stone-600">All fields are required.</p>

    <div class="space-y-5">
      <div>
        <label class="<%= label %>" for="email">Email</label>
        <input class="<%= input %>" id="email" name="email" type="email" required maxlength="254"
               autocomplete="username" placeholder="you@umass.edu">
      </div>

      <div>
        <label class="<%= label %>" for="password">Password</label>
        <input class="<%= input %>" id="password" name="password" type="password" required
               autocomplete="current-password">
      </div>
    </div>

    <div class="mt-6">
      <button id="login-submit" type="submit"
              class="w-full rounded-lg bg-red-900 px-5 py-2.5 font-semibold text-white shadow-sm hover:bg-red-950 group-[.htmx-request]:cursor-wait group-[.htmx-request]:opacity-60">
        <span class="group-[.htmx-request]:hidden">Log in</span>
        <span class="hidden group-[.htmx-request]:inline">Logging in…</span>
      </button>
    </div>
  </form>

  <%# The server's answer (error message) is swapped in here. %>
  <div id="form-feedback" class="mt-6" aria-live="polite"></div>

  <%# Shown when the request itself fails, so no server response exists to swap. %>
  <template id="tpl-network-error"><%- include('../fragments/form-error', { heading: "We couldn't log you in.", message: 'Could not reach the server. Check your connection and try again.' }) %></template>
  <template id="tpl-timeout"><%- include('../fragments/form-error', { heading: "We couldn't log you in.", message: 'The server took too long to respond. Please try again.' }) %></template>
</div>

<%- include('../partials/footer') %>
