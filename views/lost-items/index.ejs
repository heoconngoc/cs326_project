<%- include('../partials/header') %>

<div class="page-heading">
  <h1>Lost Items</h1>
  <a class="btn btn-primary" href="/lost-items/new">Report a lost item</a>
</div>

<% if (created) { %>
  <div class="alert alert-success" role="status">
    Your lost item was submitted successfully.
  </div>
<% } %>

<% if (items.length === 0) { %>
  <div class="empty-state">
    <p>No lost items have been reported yet.</p>
    <a href="/lost-items/new">Be the first to report one</a>
  </div>
<% } else { %>
  <ul class="item-grid">
    <% items.forEach((item) => { %>
      <li class="card">
        <div class="card-top">
          <h2><%= item.title %></h2>
          <span class="badge badge-<%= item.status %>"><%= item.status %></span>
        </div>
        <p class="card-desc"><%= item.description %></p>
        <dl class="card-meta">
          <dt>Category</dt><dd><%= item.category %></dd>
          <dt>Location</dt><dd><%= item.location %></dd>
          <dt>Date lost</dt><dd><%= item.dateLost %></dd>
          <% if (item.color) { %><dt>Color</dt><dd><%= item.color %></dd><% } %>
          <% if (item.brand) { %><dt>Brand</dt><dd><%= item.brand %></dd><% } %>
        </dl>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('../partials/footer') %>
