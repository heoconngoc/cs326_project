<%- include('../partials/header', { useHtmx: true }) %>
<%
  const input = 'block w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-base shadow-sm placeholder:text-stone-400 focus:border-red-800 focus:outline-none focus:ring-2 focus:ring-red-800/30 user-invalid:border-red-600 user-invalid:bg-red-50';
  const label = 'mb-1 block text-sm font-medium text-stone-800';
  const hint = 'mt-1 text-xs text-stone-500';
%>

<div class="mx-auto max-w-2xl">
  <h1 class="mb-6 text-2xl font-bold tracking-tight">Report a Lost Item</h1>

  <%# hx-post sends the form to POST /lost-items and swaps the HTML fragment
      it returns into #form-feedback. The page itself never reloads. %>
  <form id="lost-item-form" action="/lost-items" method="post"
        class="group rounded-xl border border-stone-200 bg-white p-4 shadow-sm sm:p-6"
        hx-post="/lost-items"
        hx-target="#form-feedback"
        hx-swap="innerHTML show:#form-feedback:top"
        hx-disabled-elt="find button[type='submit']"
        hx-on::after-request="if (event.detail.successful) this.reset()"
        hx-on::send-error="document.getElementById('form-feedback').innerHTML = document.getElementById('tpl-network-error').innerHTML"
        hx-on::timeout="document.getElementById('form-feedback').innerHTML = document.getElementById('tpl-timeout').innerHTML">
    <div class="grid gap-5 md:grid-cols-2">
      <div class="md:col-span-2">
        <label class="<%= label %>" for="title">Title <span class="text-red-700">*</span></label>
        <input class="<%= input %>" id="title" name="title" type="text" required minlength="3" maxlength="100"
               placeholder="e.g. Black badminton racket">
        <p class="<%= hint %>">3–100 characters</p>
      </div>

      <div class="md:col-span-2">
        <label class="<%= label %>" for="description">Description <span class="text-red-700">*</span></label>
        <textarea class="<%= input %>" id="description" name="description" rows="4" required maxlength="1000"
                  placeholder="Anything that helps identify it"></textarea>
        <p class="<%= hint %>">Up to 1000 characters</p>
      </div>

      <div>
        <label class="<%= label %>" for="category">Category <span class="text-red-700">*</span></label>
        <input class="<%= input %>" id="category" name="category" type="text" required maxlength="50"
               list="category-options" placeholder="e.g. Sport">
        <datalist id="category-options">
          <% categories.forEach((c) => { %>
            <option value="<%= c %>"></option>
          <% }) %>
        </datalist>
      </div>

      <div>
        <label class="<%= label %>" for="dateLost">Date lost <span class="text-red-700">*</span></label>
        <input class="<%= input %>" id="dateLost" name="dateLost" type="date" required max="<%= today %>">
      </div>

      <div class="md:col-span-2">
        <label class="<%= label %>" for="location">Location <span class="text-red-700">*</span></label>
        <input class="<%= input %>" id="location" name="location" type="text" required maxlength="150"
               placeholder="e.g. Franklin Dining Commons">
      </div>

      <div>
        <label class="<%= label %>" for="color">Color</label>
        <input class="<%= input %>" id="color" name="color" type="text" maxlength="50">
      </div>

      <div>
        <label class="<%= label %>" for="brand">Brand</label>
        <input class="<%= input %>" id="brand" name="brand" type="text" maxlength="80">
      </div>

      <div class="md:col-span-2">
        <label class="<%= label %>" for="contactInfo">Contact info</label>
        <input class="<%= input %>" id="contactInfo" name="contactInfo" type="text" maxlength="150"
               placeholder="e.g. you@umass.edu">
        <p class="<%= hint %>">Stored for staff only. It is not shown on the public list.</p>
      </div>
    </div>

    <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <a class="rounded-lg border border-stone-300 bg-white px-5 py-2.5 text-center font-semibold text-stone-800 hover:bg-stone-100" href="/lost-items">Cancel</a>
      <button type="submit" class="rounded-lg bg-red-900 px-5 py-2.5 font-semibold text-white shadow-sm hover:bg-red-950 disabled:cursor-not-allowed disabled:opacity-60">
        <span class="group-[.htmx-request]:hidden">Submit</span>
        <span class="hidden group-[.htmx-request]:inline">Submitting…</span>
      </button>
    </div>
  </form>

  <%# The server's answer (success card or error message) is swapped in here. %>
  <div id="form-feedback" class="mt-6" aria-live="polite"></div>

  <%# Shown when the request itself fails, so no server response exists to swap. %>
  <template id="tpl-network-error"><%- include('../fragments/form-error', { message: 'Could not reach the server. Check your connection and try again.' }) %></template>
  <template id="tpl-timeout"><%- include('../fragments/form-error', { message: 'The server took too long to respond. Please try again.' }) %></template>
</div>

<%- include('../partials/footer') %>
