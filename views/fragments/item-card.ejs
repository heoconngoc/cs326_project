<%
  const badge = item.status === 'open'
    ? 'bg-emerald-100 text-emerald-800'
    : 'bg-stone-200 text-stone-600';
%>
<article class="w-full min-w-0 rounded-xl border border-stone-200 bg-white p-4 shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <h2 class="min-w-0 break-words text-lg font-semibold leading-snug"><%= item.title %></h2>
    <span class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide <%= badge %>"><%= item.status %></span>
  </div>
  <p class="mt-2 break-words text-stone-600"><%= item.description %></p>
  <dl class="mt-4 grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1 text-sm">
    <dt class="text-stone-500">Category</dt>
    <dd class="min-w-0 break-words"><%= item.category %></dd>
    <dt class="text-stone-500">Location</dt>
    <dd class="min-w-0 break-words"><%= item.location %></dd>
    <dt class="text-stone-500">Date lost</dt>
    <dd><%= item.dateLost %></dd>
    <% if (item.color) { %>
      <dt class="text-stone-500">Color</dt>
      <dd class="min-w-0 break-words"><%= item.color %></dd>
    <% } %>
    <% if (item.brand) { %>
      <dt class="text-stone-500">Brand</dt>
      <dd class="min-w-0 break-words"><%= item.brand %></dd>
    <% } %>
  </dl>
</article>
