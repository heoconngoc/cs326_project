<%
  // Fields shared by the report form (new.ejs) and the edit form (show.ejs).
  // values: item to pre-fill from ({} for an empty form); withContact: show the contact field.
  const input = 'block w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-base shadow-sm placeholder:text-stone-400 focus:border-red-800 focus:outline-none focus:ring-2 focus:ring-red-800/30 user-invalid:border-red-600 user-invalid:bg-red-50';
  const label = 'mb-1 block text-sm font-medium text-stone-800';
  const hint = 'mt-1 text-xs text-stone-500';
  const v = (name) => (values && values[name] != null ? values[name] : '');
  const showContact = typeof withContact !== 'undefined' && withContact;
%>
<div class="md:col-span-2">
  <label class="<%= label %>" for="title">Title <span class="text-red-700">*</span></label>
  <input class="<%= input %>" id="title" name="title" type="text" required minlength="3" maxlength="100"
         placeholder="e.g. Black badminton racket" value="<%= v('title') %>">
  <p class="<%= hint %>">3–100 characters</p>
</div>

<div class="md:col-span-2">
  <label class="<%= label %>" for="description">Description <span class="text-red-700">*</span></label>
  <textarea class="<%= input %>" id="description" name="description" rows="4" required maxlength="1000"
            placeholder="Anything that helps identify it"><%= v('description') %></textarea>
  <p class="<%= hint %>">Up to 1000 characters</p>
</div>

<div>
  <label class="<%= label %>" for="category">Category <span class="text-red-700">*</span></label>
  <input class="<%= input %>" id="category" name="category" type="text" required maxlength="50"
         list="category-options" placeholder="e.g. Sport" value="<%= v('category') %>">
  <datalist id="category-options">
    <% categories.forEach((c) => { %>
      <option value="<%= c %>"></option>
    <% }) %>
  </datalist>
</div>

<div>
  <label class="<%= label %>" for="dateLost">Date lost <span class="text-red-700">*</span></label>
  <input class="<%= input %>" id="dateLost" name="dateLost" type="date" required max="<%= today %>" value="<%= v('dateLost') %>">
</div>

<div class="md:col-span-2">
  <label class="<%= label %>" for="location">Location <span class="text-red-700">*</span></label>
  <input class="<%= input %>" id="location" name="location" type="text" required maxlength="150"
         placeholder="e.g. Franklin Dining Commons" value="<%= v('location') %>">
</div>

<div>
  <label class="<%= label %>" for="color">Color</label>
  <input class="<%= input %>" id="color" name="color" type="text" maxlength="50" value="<%= v('color') %>">
</div>

<div>
  <label class="<%= label %>" for="brand">Brand</label>
  <input class="<%= input %>" id="brand" name="brand" type="text" maxlength="80" value="<%= v('brand') %>">
</div>

<% if (showContact) { %>
  <div class="md:col-span-2">
    <label class="<%= label %>" for="contactInfo">Contact info</label>
    <input class="<%= input %>" id="contactInfo" name="contactInfo" type="text" maxlength="150"
           placeholder="e.g. you@umass.edu">
    <p class="<%= hint %>">Stored for staff only. It is not shown on the public list.</p>
  </div>
<% } %>
